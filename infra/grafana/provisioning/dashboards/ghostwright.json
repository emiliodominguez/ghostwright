{
	"title": "Ghostwright",
	"uid": "ghostwright",
	"schemaVersion": 39,
	"editable": true,
	"time": { "from": "now-1h", "to": "now" },
	"panels": [
		{
			"id": 1,
			"title": "Run throughput (runs/sec)",
			"type": "timeseries",
			"gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [{ "expr": "sum(rate(ghostwright_runs_total[5m]))", "legendFormat": "runs/s" }]
		},
		{
			"id": 2,
			"title": "Runs by status",
			"type": "timeseries",
			"gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [{ "expr": "sum by (status) (ghostwright_runs_total)", "legendFormat": "{{status}}" }]
		},
		{
			"id": 3,
			"title": "p95 step duration (ms)",
			"type": "timeseries",
			"gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(ghostwright_step_duration_ms_bucket[5m])))", "legendFormat": "p95" }]
		}
	]
}
