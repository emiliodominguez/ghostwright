---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StepBuilder from '../../components/StepBuilder.tsx';
import DeleteAction from '../../components/DeleteAction.tsx';
import EditAction from '../../components/EditAction.tsx';
import StepSegments from '../../components/StepSegments.astro';
import { createCaller } from '../../server/routers';
import { describeSegments, parseTest, type DescSegment } from '@ghostwright/dsl';

const actions = await createCaller().actions.list();

/** Styled-segment preview of an action's steps (best-effort). */
function preview(dsl: string): DescSegment[][] {
	try {
		return parseTest(JSON.parse(dsl)).steps.map(describeSegments);
	} catch {
		return [];
	}
}
---

<Layout title="Actions" wide>
	<PageHeader title="Actions">
		Reusable groups of steps. Build one here, then drop it into any test from the “Add an action” palette.
	</PageHeader>

	<div class="split">
		<section>
			<h2 class="col-title">Your actions</h2>
			{
				actions.length === 0 ? (
					<div class="empty">No actions yet. Build your first one on the right.</div>
				) : (
					<ul class="action-list">
						{actions.map((a) => {
							const lines = preview(a.dsl);
							return (
								<li class="action-card">
									<div class="action-head">
										<span class="action-name">
											<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="star" aria-hidden="true">
												<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
											</svg>
											{a.name}
										</span>
										<div class="action-meta">
											<span class="count">{lines.length} step{lines.length === 1 ? '' : 's'}</span>
											<EditAction client:load id={a.id} name={a.name} dsl={a.dsl} />
											<DeleteAction client:load id={a.id} />
										</div>
									</div>
									<ol class="preview">
										{lines.map((segments, i) => (
											<li>
												<span class="idx">{i + 1}.</span> <StepSegments segments={segments} />
											</li>
										))}
									</ol>
								</li>
							);
						})}
					</ul>
				)
			}
		</section>

		<section>
			<h2 class="col-title">Build an action</h2>
			<p class="col-sub">Add the steps this action should perform, name it, and save.</p>
			<StepBuilder client:only="solid-js" mode="action" />
		</section>
	</div>
</Layout>

<style lang="scss">
	@use '../../styles/abstracts' as *;

	.split {
		display: grid;
		gap: space(10);

		@include at('lg') {
			// Same list-column width as Home/Logins/Secrets for a consistent layout.
			grid-template-columns: 30rem minmax(0, 1fr);
			gap: space(12);
			align-items: start;
		}
	}

	.col-title {
		margin-bottom: space(4);
		font-size: font-size('sm');
		font-weight: $weight-semibold;
		color: var(--text-subtle);
	}

	.col-sub {
		margin: space(-3) 0 space(5);
		font-size: font-size('base');
		color: var(--text-subtle);
	}

	.empty {
		padding: space(8) space(4);
		border: 1px dashed var(--border);
		border-radius: radius('xl');
		text-align: center;
		font-size: font-size('base');
		color: var(--text-subtle);
	}

	.action-list {
		display: flex;
		flex-direction: column;
		gap: space(3);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.action-card {
		@include card;
		padding: space(4);
	}

	.action-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: space(3);
		margin-bottom: space(2);
	}

	.action-name {
		display: inline-flex;
		align-items: center;
		gap: space(2);
		font-weight: $weight-medium;

		.star {
			color: var(--accent-text);
		}
	}

	.action-meta {
		display: flex;
		align-items: center;
		gap: space(2);
	}

	.count {
		font-size: font-size('xs');
		color: var(--text-faint);
	}

	.preview {
		display: flex;
		flex-direction: column;
		gap: space(1);
		padding-left: space(1);
		list-style: none;
		margin: 0;
		font-size: font-size('xs');
		color: var(--text-muted);

		.idx {
			color: var(--text-faint);
		}
	}
</style>
