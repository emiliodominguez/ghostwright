---
import Layout from '../../layouts/Layout.astro';
import StepBuilder from '../../components/StepBuilder.tsx';
import DeleteAction from '../../components/DeleteAction.tsx';
import { createCaller } from '../../server/routers';
import { describeStep, parseTest } from '@ghostwright/dsl';

const actions = await createCaller().actions.list();

/** Plain-language preview of an action's steps (best-effort). */
function preview(dsl: string): string[] {
	try {
		return parseTest(JSON.parse(dsl)).steps.map(describeStep);
	} catch {
		return [];
	}
}
---

<Layout title="Actions">
	<div class="mb-8">
		<a href="/" class="text-xs text-white/40 hover:text-white/70">← home</a>
		<h1 class="mt-1 text-2xl font-semibold tracking-tight">Actions</h1>
		<p class="mt-1 text-sm text-white/40">
			Reusable groups of steps. Build one here, then drop it into any test from the “Add an action” palette.
		</p>
	</div>

	<div class="grid gap-10 md:grid-cols-[0.85fr_1.15fr]">
		<section>
			<h2 class="mb-4 text-sm font-semibold text-white/50">Your actions</h2>
			{
				actions.length === 0 ? (
					<div class="rounded-xl border border-dashed border-white/10 px-4 py-8 text-center text-sm text-white/40">
						No actions yet. Build your first one on the right. ⭐
					</div>
				) : (
					<ul class="space-y-3">
						{actions.map((a) => {
							const lines = preview(a.dsl);
							return (
								<li class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
									<div class="mb-2 flex items-center justify-between gap-3">
										<span class="flex items-center gap-2 font-medium">
											<span>⭐</span>
											{a.name}
										</span>
										<div class="flex items-center gap-2">
											<span class="text-xs text-white/30">{lines.length} step{lines.length === 1 ? '' : 's'}</span>
											<DeleteAction client:load id={a.id} />
										</div>
									</div>
									<ol class="space-y-1 pl-1 text-xs text-white/55">
										{lines.map((l, i) => (
											<li>
												<span class="text-white/30">{i + 1}.</span> {l}
											</li>
										))}
									</ol>
								</li>
							);
						})}
					</ul>
				)
			}
		</section>

		<section>
			<h2 class="mb-1 text-sm font-semibold text-white/50">Build an action</h2>
			<p class="mb-5 text-sm text-white/40">Add the steps this action should perform, name it, and save.</p>
			<StepBuilder client:only="solid-js" mode="action" />
		</section>
	</div>
</Layout>
