---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import LoginsManager from '../components/LoginsManager.tsx';
---

<Layout title="Logins" wide>
	<PageHeader title="Logins">
		Build a login flow once, capture its session, then bind it to any test so runs start already signed in. Use <code>{'{{secret.NAME}}'}</code>{' '}
		for passwords and the <strong>Enter a 2-factor code</strong> step for TOTP. End the flow with a <strong>Check something is visible</strong> step so
		a failed login is caught.
	</PageHeader>

	<LoginsManager client:only="solid-js" />
</Layout>
