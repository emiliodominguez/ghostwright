---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import StepBuilder from '../components/StepBuilder.tsx';
import LoginFlows from '../components/LoginFlows.tsx';
---

<Layout title="Logins" wide>
	<PageHeader title="Logins">
		Build a login flow once, capture its session, then bind it to any test so runs start already signed in. Use <code>{'{{secret.NAME}}'}</code>{' '}
		for passwords and the <strong>Enter a 2-factor code</strong> step for TOTP. End the flow with a <strong>Check something is visible</strong> step so
		a failed login is caught.
	</PageHeader>

	<div class="split">
		<section>
			<h2 class="col-title">Your login flows</h2>
			<LoginFlows client:only="solid-js" />
		</section>
		<section>
			<h2 class="col-title">Build a login flow</h2>
			<p class="col-sub">Go to the login page, type credentials, sign in, and check you’re in.</p>
			<StepBuilder client:only="solid-js" mode="login" />
		</section>
	</div>
</Layout>

<style lang="scss">
	@use '../styles/abstracts' as *;

	.split {
		display: grid;
		gap: space(10);

		@include at('lg') {
			grid-template-columns: 22rem minmax(0, 1fr);
			gap: space(12);
			align-items: start;
		}
	}

	.col-title {
		margin-bottom: space(4);
		font-size: font-size('sm');
		font-weight: $weight-semibold;
		color: var(--text-subtle);
	}

	.col-sub {
		margin: space(-3) 0 space(5);
		font-size: font-size('base');
		color: var(--text-subtle);
	}
</style>
