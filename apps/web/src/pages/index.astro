---
import Layout from '../layouts/Layout.astro';
import StepBuilder from '../components/StepBuilder.tsx';
import { createCaller } from '../server/routers';

const tests = await createCaller().tests.list();
---

<Layout>
	<div class="grid gap-10 md:grid-cols-[0.85fr_1.15fr]">
		<section>
			<h1 class="mb-1 text-lg font-semibold tracking-tight">Your tests</h1>
			<p class="mb-4 text-sm text-white/40">Everything you're keeping an eye on.</p>
			{
				tests.length === 0 ? (
					<div class="rounded-xl border border-dashed border-white/10 px-4 py-8 text-center text-sm text-white/40">
						No tests yet. Build your first one on the right — no coding needed. ✨
					</div>
				) : (
					<ul class="space-y-2">
						{tests.map((t) => (
							<li>
								<a
									href={`/tests/${t.id}`}
									class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm transition hover:border-white/25 hover:bg-white/[0.05]"
								>
									<span class="font-medium">{t.name}</span>
									<span class="text-white/30">→</span>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</section>
		<section>
			<h2 class="mb-1 text-lg font-semibold tracking-tight">Build a test</h2>
			<p class="mb-5 text-sm text-white/40">Add steps in plain language. We'll do the rest.</p>
			<StepBuilder client:only="solid-js" />
		</section>
	</div>
</Layout>
