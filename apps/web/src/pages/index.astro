---
import Layout from '../layouts/Layout.astro';
import StepBuilder from '../components/StepBuilder.tsx';
import TestList from '../components/TestList.tsx';
import { createCaller } from '../server/routers';

const caller = createCaller();
const [tests, folders] = await Promise.all([caller.tests.list(), caller.folders.list()]);
---

<Layout wide>
	<div class="dashboard">
		<section class="col">
			<header class="panel-head">
				<h1 class="panel-title">
					Your tests
					{tests.length > 0 && <span class="count">{tests.length}</span>}
				</h1>
				<p class="panel-sub">Everything you are watching.</p>
			</header>
			<TestList
				client:load
				initial={tests.map((t) => ({ id: t.id, name: t.name, folderId: t.folderId, lastStatus: t.lastStatus }))}
				initialFolders={folders.map((f) => ({ id: f.id, name: f.name, parentId: f.parentId, collapsed: f.collapsed }))}
			/>
		</section>
		<section class="col">
			<header class="panel-head">
				<h2 class="panel-title">Build a test</h2>
				<p class="panel-sub">Add steps in plain language, and we will do the rest.</p>
			</header>
			<StepBuilder client:only="solid-js" />
		</section>
	</div>
</Layout>

<style lang="scss">
	@use '../styles/abstracts' as *;

	.dashboard {
		display: grid;
		gap: space(10);

		@include at('lg') {
			grid-template-columns: 30rem minmax(0, 1fr);
			gap: space(12);
			align-items: start;
		}
	}

	.panel-head {
		margin-bottom: space(4);
	}

	.panel-title {
		display: flex;
		align-items: center;
		gap: space(2);
		font-size: font-size('lg');
		font-weight: $weight-semibold;
		letter-spacing: -0.01em;
	}

	.count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.375rem;
		height: 1.375rem;
		padding-inline: space(1.5);
		border-radius: radius('full');
		background-color: var(--surface-3);
		color: var(--text-muted);
		font-size: font-size('2xs');
		font-weight: $weight-medium;
	}

	.panel-sub {
		margin-top: space(1);
		color: var(--text-subtle);
		font-size: font-size('base');
	}

</style>
