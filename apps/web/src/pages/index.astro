---
import Layout from '../layouts/Layout.astro';
import StepBuilder from '../components/StepBuilder.tsx';
import { createCaller } from '../server/routers';

const tests = await createCaller().tests.list();
---

<Layout>
	<div class="dashboard">
		<section class="col">
			<header class="panel-head">
				<h1 class="panel-title">
					Your tests
					{tests.length > 0 && <span class="count">{tests.length}</span>}
				</h1>
				<p class="panel-sub">Everything you're keeping an eye on.</p>
			</header>
			{
				tests.length === 0 ? (
					<div class="empty">
						<svg viewBox="0 0 32 32" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
							<path d="M16 4C11.6 4 8 7.6 8 12v13c0 .8.95 1.2 1.5.65L11.5 24l1.9 1.65a1 1 0 0 0 1.3 0L16.5 24l1.9 1.65a1 1 0 0 0 1.3 0L21.5 24l1.95 1.65c.55.55 1.55.15 1.55-.65V12c0-4.4-3.6-8-8-8z" />
							<circle cx="13" cy="13" r="1.2" fill="currentColor" stroke="none" />
							<circle cx="19" cy="13" r="1.2" fill="currentColor" stroke="none" />
						</svg>
						<p>No tests yet.</p>
						<span>Build your first one on the right — no coding needed.</span>
					</div>
				) : (
					<ul class="test-list">
						{tests.map((t) => (
							<li>
								<a href={`/tests/${t.id}`} class="test-item">
									<span class="name">{t.name}</span>
									<svg class="chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="m9 18 6-6-6-6" />
									</svg>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</section>
		<section class="col">
			<header class="panel-head">
				<h2 class="panel-title">Build a test</h2>
				<p class="panel-sub">Add steps in plain language. We'll do the rest.</p>
			</header>
			<StepBuilder client:only="solid-js" />
		</section>
	</div>
</Layout>

<style lang="scss">
	@use '../styles/abstracts' as *;

	.dashboard {
		display: grid;
		gap: space(10);

		@include at('md') {
			grid-template-columns: 0.85fr 1.15fr;
		}
	}

	.panel-head {
		margin-bottom: space(4);
	}

	.panel-title {
		display: flex;
		align-items: center;
		gap: space(2);
		font-size: font-size('lg');
		font-weight: $weight-semibold;
		letter-spacing: -0.01em;
	}

	.count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.375rem;
		height: 1.375rem;
		padding-inline: space(1.5);
		border-radius: radius('full');
		background-color: var(--surface-3);
		color: var(--text-muted);
		font-size: font-size('2xs');
		font-weight: $weight-medium;
	}

	.panel-sub {
		margin-top: space(1);
		color: var(--text-subtle);
		font-size: font-size('base');
	}

	.test-list {
		display: flex;
		flex-direction: column;
		gap: space(2);
		list-style: none;
		padding: 0;
	}

	.test-item {
		@include card;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: space(3);
		padding: space(3.5) space(4);
		font-size: font-size('base');
		transition:
			border-color $transition-base $ease,
			background-color $transition-base $ease,
			transform $transition-fast $ease;

		.name {
			font-weight: $weight-medium;
		}

		.chevron {
			color: var(--text-faint);
			transition:
				color $transition-base $ease,
				transform $transition-base $ease;
		}

		&:hover {
			border-color: var(--accent-border);
			background-color: var(--surface-3);

			.chevron {
				color: var(--accent-text);
				transform: translateX(2px);
			}
		}

		&:focus-visible {
			@include focus-ring;
		}
	}

	.empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: space(1);
		padding: space(10) space(6);
		border: 1px dashed var(--border);
		border-radius: radius('xl');
		text-align: center;

		svg {
			color: var(--text-faint);
			margin-bottom: space(2);
		}

		p {
			color: var(--text);
			font-weight: $weight-medium;
			font-size: font-size('base');
		}

		span {
			color: var(--text-subtle);
			font-size: font-size('sm');
		}
	}
</style>
