---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SecretsManager from '../components/SecretsManager.tsx';
---

<Layout title="Secrets" wide>
	<PageHeader title="Secrets">
		Encrypted credentials for logging in. Reference a password anywhere as <code>{'{{secret.NAME}}'}</code>, and use a 2-factor seed from the{' '}
		<strong>Enter a 2-factor code</strong> step.
	</PageHeader>
	<SecretsManager client:only="solid-js" />
</Layout>
