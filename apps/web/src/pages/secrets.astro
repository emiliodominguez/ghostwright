---
import Layout from '../layouts/Layout.astro';
import SecretsManager from '../components/SecretsManager.tsx';
---

<Layout title="Secrets">
	<div class="mb-8">
		<a href="/" class="text-xs text-white/40 hover:text-white/70">← home</a>
		<h1 class="mt-1 text-2xl font-semibold tracking-tight">Secrets</h1>
		<p class="mt-1 text-sm text-white/40">
			Encrypted credentials for logging in. Reference a password anywhere as <code class="text-white/60">{'{{secret.NAME}}'}</code>, and use a
			2-factor seed from the <strong>Enter a 2-factor code</strong> step.
		</p>
	</div>
	<div class="max-w-2xl">
		<SecretsManager client:only="solid-js" />
	</div>
</Layout>
