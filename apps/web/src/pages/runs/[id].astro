---
import Layout from '../../layouts/Layout.astro';
import ApproveBaseline from '../../components/ApproveBaseline.tsx';
import RunActions from '../../components/RunActions.tsx';
import BrowserLogo from '../../components/BrowserLogo.tsx';
import StepSegments from '../../components/StepSegments.astro';
import { createCaller } from '../../server/routers';
import { runStatus, stepStatus, stripAnsi } from '../../lib/status';

const { id } = Astro.params;
const data = id ? await createCaller().runs.get({ id }) : null;
if (!data?.run) return Astro.redirect('/');
const { run, steps, descriptions, descriptionSegments, test } = data;
const inProgress = run.status === 'queued' || run.status === 'running';
const traceSrc = run.traceKey ? `/trace-viewer/index.html?trace=${encodeURIComponent('/artifacts/' + run.traceKey)}` : null;
const triage = run.triage ? (JSON.parse(run.triage) as { summary: string; likelyCause: string; suggestedFix: string }) : null;
const status = runStatus(run.status);

const started = run.startedAt ?? run.createdAt;
const totalMs = run.startedAt && run.finishedAt ? run.finishedAt.getTime() - run.startedAt.getTime() : null;
const sumStepMs = steps.reduce((n, s) => n + (s.durationMs ?? 0), 0);
const maxStepMs = Math.max(1, ...steps.map((s) => s.durationMs ?? 0));
const passed = steps.filter((s) => s.status === 'passed').length;
const failed = steps.filter((s) => s.status === 'failed').length;
const skipped = steps.filter((s) => s.status === 'skipped').length;

/** Compact duration string: 450ms · 2.0s · 1m 3s. */
function fmtDur(ms: number | null): string {
	if (ms == null) return 'None';
	if (ms < 1000) return `${ms}ms`;
	const s = ms / 1000;
	if (s < 60) return `${s.toFixed(s < 10 ? 1 : 0)}s`;
	const m = Math.floor(s / 60);
	return `${m}m ${Math.round(s % 60)}s`;
}

const stats: { label: string; value: string; key?: string; browser?: string }[] = [
	{ label: 'Duration', value: fmtDur(totalMs ?? sumStepMs), key: 'duration' },
	{ label: 'Steps passed', value: `${passed} / ${steps.length}`, key: 'steps-passed' },
	{ label: 'Browser', value: run.browser, browser: run.browser },
	{ label: 'Viewport', value: run.viewport },
	{ label: 'Started', value: new Date(started).toLocaleString() },
];

const artifacts: { label: string; href: string; newTab?: boolean }[] = [];
if (traceSrc) artifacts.push({ label: 'Open trace viewer', href: traceSrc, newTab: true });
if (run.videoKey) artifacts.push({ label: 'Download video', href: `/artifacts/${run.videoKey}`, newTab: true });
if (run.harKey) artifacts.push({ label: 'Download HAR', href: `/artifacts/${run.harKey}`, newTab: true });
if (run.screenshotKey) artifacts.push({ label: 'Full-page screenshot', href: `/artifacts/${run.screenshotKey}`, newTab: true });
---

<Layout title={test ? `${test.name} result` : `Run ${run.id.slice(0, 8)}`} wide>
	<header class="page-head">
		<a href={test ? `/tests/${test.id}` : '/'} class="back">
			<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline>
			</svg>
			{test ? test.name : 'home'}
		</a>
		<div class="head-row">
			<h1>Test result</h1>
			<span class="badge" data-tone={status.tone} data-run-badge>
				{inProgress && <span class="dot" data-tone="running"></span>}
				<span data-run-label>{status.label}</span>
			</span>
			{!inProgress && <div class="head-actions"><RunActions client:load id={run.id} status={run.status} testId={test?.id} /></div>}
		</div>
		<p class="run-id">Run {run.id.slice(0, 8)}</p>
	</header>

	{
		inProgress && (
			<p class="running-note">
				<span class="dot" data-tone="running"></span>
				Running your test. This page updates as each step finishes.
			</p>
		)
	}

	<section class="stats" aria-label="Run summary">
		{
			stats.map((s) => (
				<div class="stat">
					<span class="stat-label">{s.label}</span>
					<span class="stat-value" data-stat={s.key}>
						{s.browser && <BrowserLogo browser={s.browser} size={18} />}
						<span class:list={['stat-text', { browser: s.browser }]}>{s.value}</span>
					</span>
				</div>
			))
		}
	</section>

	{
		steps.length > 0 && (
			<div class="timeline" role="img" aria-label={`${passed} passed, ${failed} failed, ${skipped} skipped`}>
				{steps.map((s) => {
					const st = stepStatus(s.status);
					const pct = Math.max(2, ((s.durationMs ?? 0) / maxStepMs) * 100);
					return <span class="seg" data-tone={st.tone} data-seg-idx={s.idx} style={`flex: ${pct}`} title={`Step ${s.idx + 1}: ${st.label} (${fmtDur(s.durationMs ?? null)})`} />;
				})}
			</div>
		)
	}

	{run.error && <pre class="error-block">{stripAnsi(run.error)}</pre>}

	{
		triage && (
			<section class="triage">
				<h2 class="triage-head">
					<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
						<path d="M12 3l1.8 5.4 5.4 1.8-5.4 1.8L12 17.4l-1.8-5.4L4.8 10.2l5.4-1.8L12 3z" />
					</svg>
					AI triage
				</h2>
				<p class="triage-summary">{triage.summary}</p>
				<dl class="triage-dl">
					<div>
						<dt>Likely cause</dt>
						<dd>{triage.likelyCause}</dd>
					</div>
					<div>
						<dt>Suggested fix</dt>
						<dd>{triage.suggestedFix}</dd>
					</div>
				</dl>
			</section>
		)
	}

	<section class="block">
		<h2 class="section-title">Steps <span class="muted-count">{steps.length}</span></h2>
		<ul class="steps">
			{
				steps.map((s) => {
					const st = stepStatus(s.status);
					const barPct = Math.max(1, ((s.durationMs ?? 0) / maxStepMs) * 100);
					return (
						<li class="step" data-tone={st.tone} data-step-idx={s.idx}>
							<div class="step-head">
								<span class="step-num" data-tone={st.tone}>
									{s.idx + 1}
								</span>
								<span class="step-desc">{descriptionSegments[s.idx] ? <StepSegments segments={descriptionSegments[s.idx]} /> : (descriptions[s.idx] ?? s.type)}</span>
								<span class="step-status" data-tone={st.tone} data-step-status>
									{st.label}
								</span>
								{s.durationMs != null && <span class="step-dur" data-step-dur>{fmtDur(s.durationMs)}</span>}
							</div>
							{s.durationMs != null && (
								<div class="step-bar" aria-hidden="true">
									<span class="step-bar-fill" data-tone={st.tone} style={`width: ${barPct}%`} />
								</div>
							)}
							{s.error && <p class="step-error" data-step-error>{stripAnsi(s.error)}</p>}
							{s.baselineKey ? (
								<div class="diff">
									<div class="diff-meta">
										<span>{s.diffPct != null ? `Visual diff: ${s.diffPct.toFixed(2)}% changed` : 'Visual diff: baseline adopted'}</span>
										{s.diffKey && <ApproveBaseline client:load runId={run.id} stepIdx={s.idx} />}
									</div>
									<div class="diff-grid">
										<figure>
											<figcaption>baseline</figcaption>
											<a href={`/artifacts/${s.baselineKey}`} target="_blank" rel="noopener">
												<img src={`/artifacts/${s.baselineKey}`} alt="baseline" loading="lazy" />
											</a>
										</figure>
										<figure>
											<figcaption>actual</figcaption>
											{s.screenshotKey && (
												<a href={`/artifacts/${s.screenshotKey}`} target="_blank" rel="noopener">
													<img src={`/artifacts/${s.screenshotKey}`} alt="actual" loading="lazy" />
												</a>
											)}
										</figure>
										<figure>
											<figcaption>diff</figcaption>
											{s.diffKey ? (
												<a href={`/artifacts/${s.diffKey}`} target="_blank" rel="noopener">
													<img src={`/artifacts/${s.diffKey}`} alt="diff" class="diff-img" loading="lazy" />
												</a>
											) : (
												<div class="no-diff">no diff</div>
											)}
										</figure>
									</div>
								</div>
							) : (
								s.screenshotKey && (
									<a href={`/artifacts/${s.screenshotKey}`} target="_blank" rel="noopener" class="shot-link">
										<img src={`/artifacts/${s.screenshotKey}`} alt={`step ${s.idx + 1}`} class="shot" loading="lazy" />
										<span class="shot-hint">Open full size</span>
									</a>
								)
							)}
						</li>
					);
				})
			}
		</ul>
	</section>

	{
		artifacts.length > 0 && (
			<section class="block">
				<h2 class="section-title">Artifacts</h2>
				<div class="artifacts">
					{artifacts.map((a) => (
						<a class="artifact" href={a.href} target={a.newTab ? '_blank' : undefined} rel="noopener">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
								<polyline points="15 3 21 3 21 9" />
								<line x1="10" y1="14" x2="21" y2="3" />
							</svg>
							{a.label}
						</a>
					))}
				</div>
			</section>
		)
	}

	{
		traceSrc && (
			<section class="block">
				<h2 class="section-title">Trace</h2>
				<p class="trace-hint">An interactive replay of the run. Once loaded, press play or scrub the timeline to move through each moment frame by frame.</p>
				<div class="trace-panel">
					<div class="trace-bar">
						<span class="trace-name">
							<span class="dot" data-tone="neutral"></span>
							Playwright trace
						</span>
						<a class="trace-open" href={traceSrc} target="_blank" rel="noopener">
							Open full screen
							<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
								<polyline points="15 3 21 3 21 9" />
								<line x1="10" y1="14" x2="21" y2="3" />
							</svg>
						</a>
					</div>
					<button type="button" class="trace-facade" data-trace-load>
						<span class="facade-play">
							<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
								<polygon points="6 4 20 12 6 20 6 4" />
							</svg>
						</span>
						<span class="facade-title">Load interactive trace</span>
						<span class="facade-sub">Replay the run frame by frame: DOM snapshots, network, and console</span>
					</button>
					<iframe data-trace-src={traceSrc} class="trace" title="Playwright trace" hidden />
				</div>
			</section>
		)
	}

	{
		/* The trace viewer is heavy and autofocuses on load (which scrolls the page to
		   it). Load it only on an explicit click, so entering the page never jumps.
		   Its service worker must be active before the snapshot iframes load, or they
		   race it, miss the SW, and render our 404 page unstyled — so pre-register it
		   and wait for activation before mounting the viewer. */
	}
	<script is:inline>
		(function () {
			var btn = document.querySelector('[data-trace-load]');
			var frame = document.querySelector('iframe[data-trace-src]');
			if (!btn || !frame) return;

			function ensureTraceSW() {
				if (!('serviceWorker' in navigator)) return Promise.resolve();
				return navigator.serviceWorker
					.register('/trace-viewer/sw.bundle.js', { scope: '/trace-viewer/' })
					.then(function (reg) {
						if (reg.active) return;
						var sw = reg.installing || reg.waiting;
						if (!sw) return;
						return new Promise(function (resolve) {
							sw.addEventListener('statechange', function () {
								if (sw.state === 'activated') resolve();
							});
						});
					})
					.catch(function () {});
			}

			// Warm the SW up as soon as the page is idle.
			ensureTraceSW();

			btn.addEventListener('click', function () {
				btn.setAttribute('disabled', '');
				ensureTraceSW().then(function () {
					frame.src = frame.getAttribute('data-trace-src');
					frame.removeAttribute('data-trace-src');
					frame.hidden = false;
					btn.remove();
				});
			});
		})();
	</script>

	{
		/* While a run is in progress, poll a lightweight status endpoint every 2s and
		   patch the badge, timeline, and per-step rows in place — no full-page reload,
		   so the page no longer flickers. When the run reaches a terminal state we do a
		   single reload, once, to mount the trace/artifacts/triage sections (which only
		   render server-side on completion). */
	}
	{
		inProgress && (
			<script is:inline data-run-poll={run.id}>
				(function () {
					var runId = document.currentScript.getAttribute('data-run-poll');
					var RUN = {
						passed: { label: 'Passed', tone: 'success' },
						failed: { label: 'Failed', tone: 'danger' },
						errored: { label: 'Something went wrong', tone: 'warning' },
						running: { label: 'Running…', tone: 'running' },
						queued: { label: 'Waiting to start', tone: 'neutral' },
					};
					var STEP = {
						passed: { label: 'Passed', tone: 'success' },
						failed: { label: 'Failed', tone: 'danger' },
						skipped: { label: 'Skipped', tone: 'neutral' },
					};

					function fmtDur(ms) {
						if (ms == null) return '';
						if (ms < 1000) return ms + 'ms';
						var s = ms / 1000;
						if (s < 60) return s.toFixed(s < 10 ? 1 : 0) + 's';
						var m = Math.floor(s / 60);
						return m + 'm ' + Math.round(s % 60) + 's';
					}

					// Server-clock start of the run (epoch ms), set from the first poll that
					// reports it. Drives the live duration ticker below; null while queued.
					var startedAt = null;

					var durEl = document.querySelector('[data-stat="duration"]');

					// Tick the Duration stat once a second from wall-clock elapsed since the
					// run started — independent of the 2s poll cadence, so it counts smoothly.
					// The terminal reload reconciles it to the exact finishedAt − startedAt.
					function tickDuration() {
						if (durEl && startedAt != null) durEl.textContent = fmtDur(Date.now() - startedAt);
					}
					setInterval(tickDuration, 1000);

					function patchStep(row, s) {
						var meta = STEP[s.status] || { label: s.status, tone: 'neutral' };
						row.setAttribute('data-tone', meta.tone);
						row.querySelector('.step-num')?.setAttribute('data-tone', meta.tone);
						var statusEl = row.querySelector('[data-step-status]');
						if (statusEl) {
							statusEl.setAttribute('data-tone', meta.tone);
							statusEl.textContent = meta.label;
						}
						if (s.durationMs != null) {
							var stepDurEl = row.querySelector('[data-step-dur]');
							if (stepDurEl) stepDurEl.textContent = fmtDur(s.durationMs);
						}
						var seg = document.querySelector('[data-seg-idx="' + s.idx + '"]');
						if (seg) seg.setAttribute('data-tone', meta.tone);
					}

					function tick() {
						fetch('/api/runs/' + runId + '/status', { headers: { accept: 'application/json' } })
							.then(function (r) {
								return r.ok ? r.json() : null;
							})
							.then(function (data) {
								if (!data) return schedule();
								// Terminal: one reload to render trace/artifacts/triage, then stop.
								if (!data.inProgress) {
									location.reload();
									return;
								}
								// A new step result appeared (the server renders one row per
								// result, incrementally). We can patch existing rows in place,
								// but a brand-new row must come from the server — reload once to
								// pick it up. This fires only at step boundaries, not every tick,
								// so the constant flicker is gone even though new steps still cost
								// a single reload apiece.
								var domSteps = document.querySelectorAll('[data-step-idx]').length;
								if ((data.steps || []).length > domSteps) {
									location.reload();
									return;
								}
								var badge = document.querySelector('[data-run-badge]');
								var label = document.querySelector('[data-run-label]');
								var meta = RUN[data.status] || { label: data.status, tone: 'neutral' };
								if (badge) badge.setAttribute('data-tone', meta.tone);
								if (label) label.textContent = meta.label;
								// Learn the start time (it's null while queued); update the
								// ticker at once so the clock doesn't wait for the next second.
								if (data.startedAt != null) {
									startedAt = data.startedAt;
									tickDuration();
								}
								var steps = data.steps || [];
								steps.forEach(function (s) {
									var row = document.querySelector('[data-step-idx="' + s.idx + '"]');
									if (row) patchStep(row, s);
								});
								var passedEl = document.querySelector('[data-stat="steps-passed"]');
								if (passedEl) {
									var passed = steps.filter(function (s) {
										return s.status === 'passed';
									}).length;
									passedEl.textContent = passed + ' / ' + steps.length;
								}
								schedule();
							})
							.catch(schedule);
					}

					function schedule() {
						setTimeout(tick, 2000);
					}

					schedule();
				})();
			</script>
		)
	}
</Layout>

<style lang="scss">
	@use '../../styles/abstracts' as *;

	.page-head {
		margin-bottom: space(6);
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: space(1);
		max-width: 100%;
		font-size: font-size('xs');
		color: var(--text-subtle);
		transition: color $transition-base $ease;

		&:hover {
			color: var(--text-muted);
		}
	}

	.head-row {
		display: flex;
		align-items: center;
		gap: space(3);
		flex-wrap: wrap;
		margin-top: space(2);

		h1 {
			font-size: font-size('2xl');
			font-weight: $weight-semibold;
			letter-spacing: -0.01em;
		}
	}

	// Push the retry/delete actions to the far end of the header row.
	.head-actions {
		margin-left: auto;
	}

	.run-id {
		margin-top: space(1);
		font-size: font-size('xs');
		color: var(--text-faint);
		font-variant-numeric: tabular-nums;
	}

	.running-note {
		display: flex;
		align-items: center;
		gap: space(2);
		margin-bottom: space(5);
		font-size: font-size('base');
		color: var(--running-text);
	}

	// ── Summary stats ───────────────────────────────────────────────────────
	.stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: space(2);
		margin-bottom: space(4);

		@include at('sm') {
			grid-template-columns: repeat(3, 1fr);
		}
		@include at('lg') {
			grid-template-columns: repeat(5, 1fr);
		}
	}

	.stat {
		@include card;
		display: flex;
		flex-direction: column;
		gap: space(1);
		padding: space(3) space(3.5);
	}

	.stat-label {
		font-size: font-size('2xs');
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-faint);
	}

	.stat-value {
		display: flex;
		align-items: center;
		gap: space(2);
		font-size: font-size('md');
		font-weight: $weight-medium;
		font-variant-numeric: tabular-nums;
		overflow-wrap: anywhere;
	}

	// The Browser stat pairs a logo with its capitalized name.
	.stat-text.browser {
		text-transform: capitalize;
	}

	// ── Step timeline bar ───────────────────────────────────────────────────
	.timeline {
		display: flex;
		gap: 2px;
		height: 8px;
		margin-bottom: space(8);
		border-radius: radius('full');
		overflow: hidden;
	}

	.seg {
		min-width: 3px;

		&[data-tone='success'] {
			background-color: var(--success);
		}
		&[data-tone='danger'] {
			background-color: var(--danger);
		}
		&[data-tone='warning'] {
			background-color: var(--warning);
		}
		&[data-tone='running'] {
			background-color: var(--running);
		}
		&[data-tone='neutral'] {
			background-color: var(--border-strong);
		}
	}

	.error-block {
		margin-bottom: space(6);
		padding: space(3);
		border: 1px solid var(--danger-border);
		border-radius: radius('lg');
		background-color: var(--danger-soft);
		color: var(--danger-text);
		font-family: var(--font-mono);
		font-size: font-size('xs');
		overflow-x: auto;
		@include thin-scrollbar;
	}

	// ── AI triage ───────────────────────────────────────────────────────────
	.triage {
		margin-bottom: space(6);
		padding: space(4);
		border: 1px solid var(--accent-border);
		border-radius: radius('xl');
		background-color: var(--accent-soft);
	}

	.triage-head {
		display: flex;
		align-items: center;
		gap: space(2);
		margin-bottom: space(2);
		font-size: font-size('sm');
		font-weight: $weight-semibold;
		color: var(--accent-text);
	}

	.triage-summary {
		margin-bottom: space(2);
		font-size: font-size('base');
		color: var(--text);
	}

	.triage-dl {
		display: flex;
		flex-direction: column;
		gap: space(1);
		font-size: font-size('xs');
		color: var(--text-muted);

		dt {
			display: inline;
			font-weight: $weight-medium;
			color: var(--text-subtle);

			&::after {
				content: ': ';
			}
		}

		dd {
			display: inline;
			margin: 0;
		}
	}

	// ── Sections ────────────────────────────────────────────────────────────
	.block {
		margin-bottom: space(8);

		&:last-child {
			margin-bottom: 0;
		}
	}

	.section-title {
		display: flex;
		align-items: center;
		gap: space(2);
		margin-bottom: space(4);
		font-size: font-size('sm');
