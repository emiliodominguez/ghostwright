---
import Layout from '../../layouts/Layout.astro';
import ApproveBaseline from '../../components/ApproveBaseline.tsx';
import { createCaller } from '../../server/routers';
import { runStatus, stepStatus } from '../../lib/status';

const { id } = Astro.params;
const data = id ? await createCaller().runs.get({ id }) : null;
if (!data?.run) return Astro.redirect('/');
const { run, steps, descriptions } = data;
const inProgress = run.status === 'queued' || run.status === 'running';
const traceSrc = run.traceKey ? `/trace-viewer/index.html?trace=${encodeURIComponent('/artifacts/' + run.traceKey)}` : null;
const triage = run.triage ? (JSON.parse(run.triage) as { summary: string; likelyCause: string; suggestedFix: string }) : null;
const status = runStatus(run.status);
---

<Layout title={`Run ${run.id.slice(0, 8)}`}>
	<header class="page-head">
		<a href="/" class="back">
			<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline>
			</svg>
			home
		</a>
		<h1 class="result-label">Test result</h1>
		<span class="badge" data-tone={status.tone}>{status.label}</span>
	</header>

	{
		inProgress && (
			<p class="running-note">
				<span class="dot" data-tone="running"></span>
				Running your test — this page updates itself…
			</p>
		)
	}
	{run.error && <pre class="error-block">{run.error}</pre>}

	{
		triage && (
			<section class="triage">
				<h2 class="triage-head">
					<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
						<path d="M12 3l1.8 5.4 5.4 1.8-5.4 1.8L12 17.4l-1.8-5.4L4.8 10.2l5.4-1.8L12 3z" />
					</svg>
					AI triage
				</h2>
				<p class="triage-summary">{triage.summary}</p>
				<dl class="triage-dl">
					<div>
						<dt>Likely cause</dt>
						<dd>{triage.likelyCause}</dd>
					</div>
					<div>
						<dt>Suggested fix</dt>
						<dd>{triage.suggestedFix}</dd>
					</div>
				</dl>
			</section>
		)
	}

	<section class="block">
		<h2 class="section-title">Steps</h2>
		<ul class="steps">
			{
				steps.map((s) => {
					const st = stepStatus(s.status);
					return (
						<li class="step">
							<div class="step-head">
								<span class="step-num">{s.idx + 1}</span>
								<span class="step-desc">{descriptions[s.idx] ?? s.type}</span>
								<span class="step-status" data-tone={st.tone}>
									{st.label}
								</span>
								{s.durationMs != null && <span class="step-dur">{s.durationMs}ms</span>}
							</div>
							{s.error && <p class="step-error">{s.error}</p>}
							{s.baselineKey ? (
								<div class="diff">
									<div class="diff-meta">
										<span>{s.diffPct != null ? `Visual diff: ${s.diffPct.toFixed(2)}% changed` : 'Visual diff — baseline adopted'}</span>
										{s.diffKey && <ApproveBaseline client:load runId={run.id} stepIdx={s.idx} />}
									</div>
									<div class="diff-grid">
										<figure>
											<figcaption>baseline</figcaption>
											<img src={`/artifacts/${s.baselineKey}`} alt="baseline" loading="lazy" />
										</figure>
										<figure>
											<figcaption>actual</figcaption>
											{s.screenshotKey && <img src={`/artifacts/${s.screenshotKey}`} alt="actual" loading="lazy" />}
										</figure>
										<figure>
											<figcaption>diff</figcaption>
											{s.diffKey ? (
												<img src={`/artifacts/${s.diffKey}`} alt="diff" class="diff-img" loading="lazy" />
											) : (
												<div class="no-diff">no diff</div>
											)}
										</figure>
									</div>
								</div>
							) : (
								s.screenshotKey && <img src={`/artifacts/${s.screenshotKey}`} alt={`step ${s.idx}`} class="shot" loading="lazy" />
							)}
						</li>
					);
				})
			}
		</ul>
	</section>

	{
		traceSrc && (
			<section class="block">
				<h2 class="section-title">Trace</h2>
				<iframe src={traceSrc} class="trace" title="Playwright trace" />
			</section>
		)
	}

	{inProgress && <script is:inline>setTimeout(() => location.reload(), 2000);</script>}
</Layout>

<style lang="scss">
	@use '../../styles/abstracts' as *;

	.page-head {
		display: flex;
		align-items: center;
		gap: space(3);
		margin-bottom: space(6);
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: space(1);
		font-size: font-size('xs');
		color: var(--text-subtle);
		transition: color $transition-base $ease;

		&:hover {
			color: var(--text-muted);
		}
	}

	.result-label {
		font-size: font-size('sm');
		font-weight: $weight-medium;
		color: var(--text-subtle);
	}

	.running-note {
		display: flex;
		align-items: center;
		gap: space(2);
		margin-bottom: space(6);
		font-size: font-size('base');
		color: var(--running-text);
	}

	.error-block {
		margin-bottom: space(6);
		padding: space(3);
		border: 1px solid var(--danger-border);
		border-radius: radius('lg');
		background-color: var(--danger-soft);
		color: var(--danger-text);
		font-family: var(--font-mono);
		font-size: font-size('xs');
		overflow-x: auto;
		@include thin-scrollbar;
	}

	.triage {
		margin-bottom: space(6);
		padding: space(4);
		border: 1px solid var(--accent-border);
		border-radius: radius('xl');
		background-color: var(--accent-soft);
	}

	.triage-head {
		display: flex;
		align-items: center;
		gap: space(2);
		margin-bottom: space(2);
		font-size: font-size('sm');
		font-weight: $weight-semibold;
		color: var(--accent-text);
	}

	.triage-summary {
		margin-bottom: space(2);
		font-size: font-size('base');
		color: var(--text);
	}

	.triage-dl {
		display: flex;
		flex-direction: column;
		gap: space(1);
		font-size: font-size('xs');
		color: var(--text-muted);

		dt {
			display: inline;
			font-weight: $weight-medium;
			color: var(--text-subtle);

			&::after {
				content: ': ';
			}
		}

		dd {
			display: inline;
			margin: 0;
		}
	}

	.block {
		margin-bottom: space(8);

		&:last-child {
			margin-bottom: 0;
		}
	}

	.section-title {
		margin-bottom: space(3);
		font-size: font-size('sm');
		font-weight: $weight-semibold;
		color: var(--text-subtle);
	}

	.steps {
		display: flex;
		flex-direction: column;
		gap: space(3);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.step {
		@include card;
		padding: space(3);
	}

	.step-head {
		display: flex;
		align-items: center;
		gap: space(3);
	}

	.step-num {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: radius('full');
		background-color: var(--surface-3);
		color: var(--text-muted);
		font-size: font-size('xs');
		font-weight: $weight-medium;
		font-variant-numeric: tabular-nums;
	}

	.step-desc {
		flex: 1;
		font-size: font-size('base');
		color: var(--text);
	}

	.step-status {
		flex-shrink: 0;
		font-size: font-size('xs');
		font-weight: $weight-medium;

		&[data-tone='success'] {
			color: var(--success-text);
		}
		&[data-tone='danger'] {
			color: var(--danger-text);
		}
		&[data-tone='warning'] {
			color: var(--warning-text);
		}
		&[data-tone='running'] {
			color: var(--running-text);
		}
		&[data-tone='neutral'] {
			color: var(--text-subtle);
		}
	}

	.step-dur {
		flex-shrink: 0;
		font-size: font-size('xs');
		color: var(--text-faint);
		font-variant-numeric: tabular-nums;
	}

	.step-error {
		margin-top: space(2);
		font-family: var(--font-mono);
		font-size: font-size('xs');
		color: var(--danger-text);
	}

	.diff {
		margin-top: space(2);
	}

	.diff-meta {
		display: flex;
		align-items: center;
		gap: space(3);
		margin-bottom: space(2);
		font-size: font-size('xs');
		color: var(--text-subtle);
	}

	.diff-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: space(2);
	}

	figure {
		margin: 0;
	}

	figcaption {
		margin-bottom: space(1);
		font-size: font-size('2xs');
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--text-faint);
	}

	.diff-grid img {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: radius('sm');
	}

	.diff-img {
		border-color: var(--danger-border) !important;
	}

	.no-diff {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		min-height: 4rem;
		border: 1px solid var(--border);
		border-radius: radius('sm');
		font-size: font-size('2xs');
		color: var(--text-faint);
	}

	.shot {
		margin-top: space(2);
		max-height: 12rem;
		border: 1px solid var(--border);
		border-radius: radius('md');
	}

	.trace {
		width: 100%;
		height: 600px;
		border: 1px solid var(--border);
		border-radius: radius('lg');
		background-color: #fff;
	}
</style>
