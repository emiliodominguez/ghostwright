# Copy this file to .env for local development.
# The defaults below match the local Docker Compose stack (pnpm infra:up).
# See docs/configuration.md for the full reference.

# --- Application datastore (libSQL / sqld), the sole app datastore ---
DATABASE_URL=http://localhost:8180
DATABASE_AUTH_TOKEN=

# --- Queue backend (Redis, BullMQ only, not application data) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Artifact store (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Security ---
# Encrypts stored passwords and TOTP seeds. Required in production.
# Keep it stable, or existing secrets can no longer be decrypted.
GHOSTWRIGHT_SECRET_KEY=dev-only-change-me
# Optional. If set, the dashboard requires this token.
GHOSTWRIGHT_ACCESS_TOKEN=
# Set to 1 to block the worker from reaching private/loopback/link-local
# addresses (SSRF guard). Off by default so self-hosted setups can reach
# internal apps.
GHOSTWRIGHT_BLOCK_PRIVATE_NETWORK=

# --- AI (optional, enables failure triage and natural-language steps) ---
ANTHROPIC_API_KEY=
# Alternatives to an API key, if you use them:
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_PROFILE=

# --- Email alerts (only needed for the email alert channel) ---
SMTP_URL=
SMTP_FROM=

# --- Worker tuning (optional) ---
# How many runs the worker processes at once.
WORKER_CONCURRENCY=5

# --- Dashboard ---
# Port the dashboard listens on (default 4321).
WEB_PORT=4321
# Public URL of the dashboard, used in links and alerts.
PUBLIC_BASE_URL=http://localhost:4321

# --- Logging ---
# Minimum log level: debug | info | warn | error | silent.
LOG_LEVEL=info
